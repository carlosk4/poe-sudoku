<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.poesudoku.controller.SudokuController"
      styleClass="root-container"
      stylesheets="@sudoku-style.css"
      spacing="24">

    <padding>
        <Insets top="36" right="36" bottom="36" left="36"/>
    </padding>

    <GridPane fx:id="sudokuGrid" styleClass="sudoku-grid"
              hgap="0" vgap="0" alignment="CENTER"/>

    <HBox spacing="12" alignment="CENTER">
        <Button fx:id="btnUndo" text="Deshacer" styleClass="btn-secondary" onAction="#onUndo"/>
        <Button fx:id="btnNewGame" text="Nueva partida" styleClass="btn-primary" onAction="#onNewGame"/>
        <Button fx:id="btnHint" text="Ayuda"         styleClass="btn-secondary" onAction="#onHint"/>
        <Button fx:id="btnRestart" text="Reiniciar"     styleClass="btn-secondary" onAction="#onRestart"/>
    </HBox>

</VBox>