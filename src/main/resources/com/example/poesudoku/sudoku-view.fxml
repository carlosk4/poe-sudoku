<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.poesudoku.controller.SudokuController"
      styleClass="root-container"
      stylesheets="@sudoku-style.css"
      spacing="24"
      fillWidth="false">

    <padding>
        <Insets top="36" right="36" bottom="36" left="36"/>
    </padding>

    <GridPane fx:id="sudokuGrid"
              styleClass="sudoku-grid"
              hgap="0"
              vgap="0"
              alignment="CENTER"/>

    <Label fx:id="lblMessage"
           text=""
           styleClass="message-label"/>

    <HBox spacing="12" alignment="CENTER">
        <Button fx:id="btnUndo" text="Deshacer" styleClass="btn-primary" onAction="#onUndo"/>
        <Button fx:id="btnNewGame" text="Volver al menú" styleClass="btn-primary" onAction="#onNewGame"/>
        <Button fx:id="btnHint" text="Ayuda" styleClass="btn-primary" onAction="#onHint"/>
        <Button fx:id="btnRestart" text="Reiniciar" styleClass="btn-primary" onAction="#onRestart"/>
    </HBox>

</VBox>