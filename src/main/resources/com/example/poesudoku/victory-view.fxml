<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.poesudoku.controller.VictoryController"
      styleClass="root-container"
      stylesheets="@sudoku-style.css"
      spacing="24"
      fillWidth="false"
      prefWidth="620"
      prefHeight="640">

    <padding>
        <Insets top="48" right="48" bottom="48" left="48"/>
    </padding>

    <Label text="VICTORIA"
           styleClass="title"/>

    <Label fx:id="lblGrade"
           text="S+"
           styleClass="grade-label"/>

    <Label fx:id="lblHintsUsed"
           text="Pistas usadas: 0"
           styleClass="message-label"/>

    <HBox spacing="12" alignment="CENTER">
        <Button fx:id="btnMainMenu"
                text="Menú"
                styleClass="btn-primary"
                onAction="#onMainMenu"/>

        <Button fx:id="btnNewGame"
                text="Nueva partida"
                styleClass="btn-primary"
                onAction="#onNewGame"/>
    </HBox>

</VBox>
